# Copy to .env and fill in. Never commit .env.
MONGODB_URI=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NESSIE_API_KEY=
JWT_SECRET=
# Model names used by scripts/check_keys.py
CLAUDE_MODEL=
GEMINI_MODEL=
# Optional. Gemini model for the structuring call in scripts/run_trend_agent.py (default gemini-3.5-flash)
TREND_AGENT_MODEL=
# iMessage agent (imessage/): shared secret for /imessage/* endpoints. Any long random string.
IMESSAGE_AGENT_SECRET=
# Optional. 0 turns off the startup warm-up (backend/warmup.py: two small Claude calls, no Gemini quota)
SECONDLOOK_WARMUP=
# Social Radar. Generated locally by scripts/social_ingest.py if absent. Never commit the real value.
SOCIAL_HASH_SALT=
# Optional, defaults true. False stores empty post text.
STORE_TEXT=true
# Enable runtime retrieval after ingestion, embedding, graph and metrics are ready.
SOCIAL_RADAR_ENABLED=0
