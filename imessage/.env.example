# Photon (iMessage)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_PLATFORM=imessage
PHOTON_AGENT_HANDLE=
# Only for test-imessage.mjs: the phone number you text from
PHOTON_TEST_SENDER=

# Claude (analysis + replies)
ANTHROPIC_API_KEY=
# Optional, default claude-opus-5-5
SECOND_LOOK_MODEL=

# Gemini embeddings
GEMINI_API_KEY=
# Optional, defaults gemini-embedding-2 / 1536 (must match the Atlas vector indexes)
EMBED_MODEL=
EMBED_DIMS=

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=second_look
