# Photon (iMessage). Shell or repo-root .env.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_PLATFORM=imessage
PHOTON_AGENT_HANDLE=
# Only for test-imessage.mjs: the phone number you text from
PHOTON_TEST_SENDER=

# Second Look backend. IMESSAGE_AGENT_SECRET must match the backend's value in the repo-root .env.
SECOND_LOOK_API=http://localhost:8000
IMESSAGE_AGENT_SECRET=
