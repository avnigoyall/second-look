{
  "manifest_version": 3,
  "name": "Second Look",
  "version": "0.2.0",
  "description": "Checks an item in your online cart against your closet and current trends before you buy.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/sessionStore.js",
        "src/content/shadowHost.js",
        "src/content/reader/price.js",
        "src/content/reader/jsonld.js",
        "src/content/reader/meta.js",
        "src/content/reader/domPrice.js",
        "src/content/reader/details.js",
        "src/content/reader/priceWindows.js",
        "src/content/reader/readItem.js",
        "src/content/matchers.js",
        "src/content/card.styles.js",
        "src/content/card.js",
        "src/content/flow.js",
        "src/content/trigger.js",
        "src/content/removal.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Second Look",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
